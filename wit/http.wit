package laplace:http;

interface types {
    enum method {
        options,
        get,
        post,
        put,
        delete,
        head,
        trace,
        connect,
        patch,
    }

    record uri {
        scheme: string,
        authority: string,
        path-and-query: string,
    }

    record header {
        name: string,
        value: list<u8>,
    }

    record request {
        method: method,
        uri: uri,
        version: string,
        headers: list<header>,
        body: list<u8>,
    }

    record response {
        status: u16,
        version: string,
        headers: list<header>,
        body: list<u8>,
    }

}

interface by-client-handler {
    use types.{request, response};

    handle: func(request: request) -> response;
}

/// Optional: a backend that exports it runs `init` on every new instance, before its first request.
interface lifecycle {
    /// `previous-version` is the version the lapp last ran with, if it was another one: the data may
    /// need to be brought to the current format. `init` should be idempotent.
    init: func(previous-version: option<string>) -> result<_, string>;
}

world http {
    export types;
    export by-client-handler;
}

world http-init {
    include http;
    export lifecycle;
}
