package laplace:lapp@0.1.0;

/// What every lapp backend is.
///
/// The host capabilities are imported here, every one of them: the host always links them all, and
/// every function of one refuses without its permission; a built component keeps only the imports its
/// code calls.
world back {
    import database;

    export types;
    export handler;
}

/// A backend with the optional `lifecycle.init`.
world back-init {
    include back;
    export lifecycle;
}
