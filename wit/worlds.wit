package laplace:lapp@0.1.0;

/// What every lapp backend is.
///
/// The host capabilities of the later stages are imported here, every one of them: the host always
/// links them all (without a permission, a stub that refuses), and a built component keeps only the
/// imports its code calls.
world back {
    export types;
    export handler;
}

/// A backend with the optional `lifecycle.init`.
world back-init {
    include back;
    export lifecycle;
}
